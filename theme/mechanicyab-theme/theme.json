{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "720px", "wideSize": "1180px" },
    "color": {
      "palette": [
        { "slug": "primary", "color": "#2563EB", "name": "Persian Blue" },
        { "slug": "primary-hover", "color": "#1D4ED8", "name": "Primary Hover" },
        { "slug": "bg", "color": "#F8FAFC", "name": "Background" },
        { "slug": "surface", "color": "#FFFFFF", "name": "Surface" },
        { "slug": "text", "color": "#0F172A", "name": "Text" },
        { "slug": "muted", "color": "#64748B", "name": "Muted" }
      ]
    },
    "typography": { "fluid": true }
  },
  "styles": {
    "color": { "background": "var:preset|color|bg", "text": "var:preset|color|text" },
    "typography": { "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif" }
  }
}
